// Each #kernel tells which function to compile; you can have many kernels

#pragma kernel MarkEdges
#pragma kernel EvaluateSplits
#pragma kernel UnlockNodes
#pragma kernel ApplyNaturalForces
#pragma kernel MoveParticles

#include "GrowthHelpers3D.hlsl"
#include "GrowthStructs3D.hlsl"
#include "SpatialHash/SpatialHashHelpers3D.hlsl"

RWStructuredBuffer<Node3D> Nodes : register(u0);
RWStructuredBuffer<HalfEdge3D> HalfEdges : register(u1);
RWStructuredBuffer<Face3D> Faces : register(u2);

// VALUES
float deltaTime;
int frameCount;
int sliceIndex;

uint maxNodes; // basically maxNodes
uint hashTableSize; // for spatial hashing, nextpoweroftwo(maxNodes)
uint paddedNodeCount;

// physics
float separationDistance;
float separationForce;

float springStiffness;
float restLength;
float laplacianSmoothing;

float gravity;

float nodeDrag;
float splitDistanceThreshold;


//StructuredBuffer<uint> NeighborIndices;
StructuredBuffer<Entry> SpatialLookup;
StructuredBuffer<uint> StartIndices;

//RWByteAddressBuffer NodeCounter; 

RWByteAddressBuffer GlobalCounters;

Node3D AddNode(uint allocatedID, float3 position)
{
    //uint newNodeID;
    //GlobalCounters.InterlockedAdd(0, 1, newNodeID); // Byte 0 = Node Count
    
    Node3D node = (Node3D) 0;
    node.id = allocatedID;
    node.position = position;
    
    Nodes[node.id] = node;
    
    return node;
}

void ApplyNode(Node3D node)
{
    Nodes[node.id] = node;
}

HalfEdge3D AddEdge(uint allocatedID)
{
    //uint newEdgeID;
    //GlobalCounters.InterlockedAdd(4, 1, newEdgeID);
    
    HalfEdge3D edge = (HalfEdge3D) 0;
    edge.id = allocatedID;
    
    HalfEdges[edge.id] = edge;
    
    return edge;
}

void ApplyEdge(HalfEdge3D edge)
{
    HalfEdges[edge.id] = edge;
}

Face3D AddFace(uint allocatedID)
{
    //uint newFaceID;
    //GlobalCounters.InterlockedAdd(8, 1, newFaceID);
    
    Face3D face = (Face3D) 0;
    face.id = allocatedID;
    
    Faces[face.id] = face;
    
    return face;
}

void ApplyFace(Face3D face)
{
    Faces[face.id] = face;
}


void SplitTriangle(uint edgeIndex, uint allocatedNodeID, uint startEdgeID, uint startFaceID)
{
    HalfEdge3D edgeToSplit = HalfEdges[edgeIndex];

    // grab the 3 nodes involved in edgeToSplit's face
    uint topNodeID = HalfEdges[edgeToSplit.next].target;
    uint rightNodeID = edgeToSplit.target;
    uint leftNodeID = edgeToSplit.origin;

    Node3D topNode = Nodes[topNodeID];
    Node3D rightNode = Nodes[rightNodeID];
    Node3D leftNode = Nodes[leftNodeID];
    
    // create new node
    float3 midPoint = (rightNode.position + leftNode.position) / 2.0f;    
    Node3D newNode = AddNode(allocatedNodeID, midPoint);
    newNode.velocity = (rightNode.velocity + leftNode.velocity) / 2.0f;
    newNode.mass = 1.0f;
    uint newNodeID = newNode.id;
    
    // keep outer boundary edges, save references
    uint eTopLeftID = edgeToSplit.prev;
    uint eRightTopID = edgeToSplit.next;
    HalfEdge3D eTopLeft = HalfEdges[eTopLeftID];
    HalfEdge3D eRightTop = HalfEdges[eRightTopID];
    
    // reuse top face
    uint topFaceID = edgeToSplit.face;
    Face3D topFace = Faces[topFaceID];
    
    // repurpose edgeToSplit to be the new edge from leftNode -> midPoint (eLeftMid)
    uint eLeftMidID = edgeIndex;
    HalfEdge3D eLeftMid = edgeToSplit; // Re-purpose to go from leftNode -> mid
    uint eMidLeftID = edgeToSplit.twin;
    HalfEdge3D eMidLeft = HalfEdges[eMidLeftID];
    
    // create new face and new half-edges that can be used for both boundary and non-boundary splits
    Face3D newTopFace = AddFace(startFaceID);
        
    HalfEdge3D eMidTop = AddEdge(startEdgeID);
    HalfEdge3D eTopMid = AddEdge(startEdgeID + 1);
    HalfEdge3D eMidRight = AddEdge(startEdgeID + 2);
    HalfEdge3D eRightMid = AddEdge(startEdgeID + 3);
    
    uint newTopFaceID = newTopFace.id;
    
    uint eMidRightID = eMidRight.id;
    uint eRightMidID = eRightMid.id;
    uint eMidTopID = eMidTop.id;
    uint eTopMidID = eTopMid.id;
    
    
    // top right triangle
    eRightTop.face = newTopFaceID;
    eRightTop.next = eTopMidID;
    eRightTop.prev = eMidRightID;

    eMidRight.origin = newNodeID;
    eMidRight.target = rightNodeID;
    eMidRight.twin = eRightMidID;
    eMidRight.next = eRightTopID;
    eMidRight.prev = eTopMidID;
    eMidRight.face = newTopFaceID;

    eTopMid.origin = topNodeID;
    eTopMid.target = newNodeID;
    eTopMid.twin = eMidTopID;
    eTopMid.next = eMidRightID;
    eTopMid.prev = eRightTopID;
    eTopMid.face = newTopFaceID;
    
    // top left triangle
    eMidTop.origin = newNodeID;
    eMidTop.target = topNodeID;
    eMidTop.twin = eTopMidID;
    eMidTop.next = eTopLeftID;
    eMidTop.prev = eLeftMidID;
    eMidTop.face = topFaceID;

    eTopLeft.face = topFaceID;
    eTopLeft.next = eLeftMidID;
    eTopLeft.prev = eMidTopID;

    eLeftMid.origin = leftNodeID;
    eLeftMid.target = newNodeID;
    eLeftMid.twin = eMidLeftID;
    eLeftMid.next = eMidTopID;
    eLeftMid.prev = eTopLeftID;
    eLeftMid.face = topFaceID;

    // Set face pointers
    topFace.halfEdge = eLeftMidID;
    newTopFace.halfEdge = eMidRightID;

    if (edgeToSplit.isBoundary)
    {
        // --- THE STITCHING PHASE (BOUNDARY) ---

        // Top-Right Triangle (New Face)
        eMidRight.isBoundary = true;

        // Top-Left Triangle (Reused Face)
        eLeftMid.isBoundary = true; // still a boundary edge
        
        // twins (ghosts)
        eMidLeft.origin = newNodeID;
        eMidLeft.target = leftNodeID;
        eMidLeft.twin = eLeftMidID;
        // save old prev
        uint oldPrev = eMidLeft.prev;
        eMidLeft.prev = eRightMidID;
        eMidLeft.isBoundary = true;
        eMidLeft.isGhost = true;
        
        eRightMid.origin = rightNodeID;
        eRightMid.target = newNodeID;
        eRightMid.twin = eMidRightID;
        eRightMid.next = eMidLeftID;
        eRightMid.prev = oldPrev;
        eRightMid.isBoundary = true;
        eRightMid.isGhost = true;
        
        HalfEdges[oldPrev].next = eRightMidID; // fix the old prev to point to the new ghost]

        // Set face and node pointers
        newNode.halfEdge = eMidRightID;
        topNode.halfEdge = eTopLeftID;
        leftNode.halfEdge = eLeftMidID;
        rightNode.halfEdge = eRightTopID;

        // Write back
        HalfEdges[eTopLeftID] = eTopLeft;
        HalfEdges[eRightTopID] = eRightTop;
        HalfEdges[eMidLeftID] = eMidLeft;
        HalfEdges[eMidTopID] = eMidTop;
        HalfEdges[eTopMidID] = eTopMid;
        HalfEdges[eMidRightID] = eMidRight;
        
        HalfEdges[eLeftMidID] = eLeftMid;
        HalfEdges[eRightMidID] = eRightMid;

        Faces[topFaceID] = topFace;
        Faces[newTopFaceID] = newTopFace;

        Nodes[topNodeID] = topNode;
        Nodes[leftNodeID] = leftNode;
        Nodes[rightNodeID] = rightNode;
        Nodes[newNodeID] = newNode;
        
        return;
    }

    // grab bottom node
    uint bottomNodeID = HalfEdges[eMidLeft.next].target;
    Node3D bottomNode = Nodes[bottomNodeID];

    // reuse the bottom edges
    uint eBottomRightID = eMidLeft.prev;
    uint eLeftBottomID = eMidLeft.next;
    HalfEdge3D eBottomRight = HalfEdges[eBottomRightID];
    HalfEdge3D eLeftBottom = HalfEdges[eLeftBottomID];
    
    // reuse the bottom face
    uint bottomFaceID = eMidLeft.face;
    Face3D bottomFace = Faces[bottomFaceID];

    // create the 6 brand NEW half-edges and 2 NEW faces required    
    Face3D newBottomFace = AddFace(startFaceID + 1);
    uint newBottomFaceID = newBottomFace.id;

    HalfEdge3D eMidBottom = AddEdge(startEdgeID + 4);
    HalfEdge3D eBottomMid = AddEdge(startEdgeID + 5);

    // --- THE STITCHING PHASE ---
    uint eMidBottomID = eMidBottom.id;
    uint eBottomMidID = eBottomMid.id;
    
    // Bottom right Triangle
    eBottomRight.face = newBottomFaceID;
    eBottomRight.next = eRightMidID;
    eBottomRight.prev = eMidBottomID;

    eMidBottom.origin = newNodeID;
    eMidBottom.target = bottomNodeID;
    eMidBottom.twin = eBottomMidID;
    eMidBottom.next = eBottomRightID;
    eMidBottom.prev = eRightMidID;
    eMidBottom.face = newBottomFaceID;

    eRightMid.origin = rightNodeID;
    eRightMid.target = newNodeID;
    eRightMid.twin = eMidRightID;
    eRightMid.next = eMidBottomID;
    eRightMid.prev = eBottomRightID;
    eRightMid.face = newBottomFaceID;

    // Bottom left triangle
    eBottomMid.origin = bottomNodeID;
    eBottomMid.target = newNodeID;
    eBottomMid.twin = eMidBottomID;
    eBottomMid.next = eMidLeftID;
    eBottomMid.prev = eLeftBottomID;
    eBottomMid.face = bottomFaceID;

    eMidLeft.origin = newNodeID;
    eMidLeft.target = leftNodeID;
    eMidLeft.twin = eLeftMidID;
    eMidLeft.next = eLeftBottomID;
    eMidLeft.prev = eBottomMidID;
    eMidLeft.face = bottomFaceID;

    eLeftBottom.face = bottomFaceID;
    eLeftBottom.next = eBottomMidID;
    eLeftBottom.prev = eMidLeftID;

    // set face pointers
    bottomFace.halfEdge = eMidLeftID;
    newBottomFace.halfEdge = eRightMidID;
    
    // Set node pointers
    newNode.halfEdge = eMidRightID;
    topNode.halfEdge = eTopLeftID;
    leftNode.halfEdge = eLeftBottomID;
    rightNode.halfEdge = eRightTopID;
    bottomNode.halfEdge = eBottomRightID;

    // Write back modified existing Edges AND the new ones we just modified
    HalfEdges[eTopLeftID] = eTopLeft;
    HalfEdges[eRightTopID] = eRightTop;
    HalfEdges[eBottomRightID] = eBottomRight;
    HalfEdges[eLeftBottomID] = eLeftBottom;
    HalfEdges[eLeftMidID] = eLeftMid;
    HalfEdges[eMidLeftID] = eMidLeft;

    // Write back new edges
    HalfEdges[eMidTopID] = eMidTop;
    HalfEdges[eTopMidID] = eTopMid;
    HalfEdges[eMidBottomID] = eMidBottom;
    HalfEdges[eBottomMidID] = eBottomMid;
    HalfEdges[eRightMidID] = eRightMid;
    HalfEdges[eMidRightID] = eMidRight;

    // Write back Faces
    Faces[topFaceID] = topFace;
    Faces[newBottomFaceID] = newBottomFace;
    Faces[bottomFaceID] = bottomFace;
    Faces[newTopFaceID] = newTopFace;

    // Write back Nodes
    Nodes[topNodeID] = topNode;
    Nodes[bottomNodeID] = bottomNode;
    Nodes[leftNodeID] = leftNode;
    Nodes[rightNodeID] = rightNode;
    Nodes[newNodeID] = newNode;
}


RWStructuredBuffer<uint> NodeLocks; // 0 = unlocked, 1 = locked


void FlagPending()
{
    uint dummy;
    GlobalCounters.InterlockedAdd(12, 1, dummy); // Byte 12 = pendingSplits
}

[numthreads(8, 1, 1)]
void MarkEdges(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int halfEdgeCount = GlobalCounters.Load(4);

    if (index >= halfEdgeCount)
        return;
    
    if ((index + sliceIndex) % 4 != 0) 
        return;
    
    HalfEdge3D edge = HalfEdges[index];
    HalfEdge3D twinEdge = HalfEdges[edge.twin];
    
    // dont let ghost edges mark for splitting
    if (edge.isGhost)
        return;
    
    // Only allow the lower half-edge ID to handle the split evaluation
    if (index > edge.twin) 
        return;

    // determine if the edge wants to split
    Node3D originNode = Nodes[edge.origin];
    Node3D targetNode = Nodes[edge.target];
    float dist = distance(originNode.position, targetNode.position);

    if (dist > splitDistanceThreshold)
    {
        HalfEdges[index].wantsToSplit = 1;
    }
    
    // determine if the edge CAN split
    if (HalfEdges[index].wantsToSplit == 1)
    {
        uint topNodeID = HalfEdges[edge.next].target;
        uint rightNodeID = edge.target;
        uint leftNodeID = edge.origin;
        uint bottomNodeID = UINT_MAX;
        
        if (!edge.isBoundary)
        {
            bottomNodeID = HalfEdges[HalfEdges[edge.twin].next].target;
        }
        
        uint lockTop, lockBottom, lockRight, lockLeft;

        // interlocked compare exchange is an atomic operation that sets the value at the given address to the new value (3rd parameter)
        // IFF the current value at that address is equal to the expected value (2nd parameter).
        // interlocked compare exchange returns the OLD value, 
        // so if it returns 0 that means we successfully set it to 1 and acquired the lock
        
        // Try to lock Left (try to set to 1 if it's currently 0, and store the old value in lockLeft)
        InterlockedCompareExchange(NodeLocks[leftNodeID], 0, 1, lockLeft);
        if (lockLeft != 0)
        {
            FlagPending();
            return; // Failed! Abort. (lockLeft was 1, meaning some other thread has locked this node, so we can't split this edge)
        }

        // Try to lock Right
        InterlockedCompareExchange(NodeLocks[rightNodeID], 0, 1, lockRight);
        if (lockRight != 0)
        {
            InterlockedExchange(NodeLocks[leftNodeID], 0, lockLeft);
            FlagPending();
            return;
        }

        // Try to lock Top
        InterlockedCompareExchange(NodeLocks[topNodeID], 0, 1, lockTop);
        if (lockTop != 0)
        {
            // Failed! Unlock Left and Right.
            InterlockedExchange(NodeLocks[leftNodeID], 0, lockLeft);
            InterlockedExchange(NodeLocks[rightNodeID], 0, lockRight);
            FlagPending();
            return;
        }

        // Try to lock Bottom (if not at boundary, otherwise there is no bottom!)
        if (!edge.isBoundary)
        {
            InterlockedCompareExchange(NodeLocks[bottomNodeID], 0, 1, lockBottom);
            if (lockBottom != 0)
            {
            // Failed! Unlock Left, Right, and Top.
                InterlockedExchange(NodeLocks[leftNodeID], 0, lockLeft);
                InterlockedExchange(NodeLocks[rightNodeID], 0, lockRight);
                InterlockedExchange(NodeLocks[topNodeID], 0, lockTop);
                FlagPending();
                return;
            }            
        }
        
        // SUCCESS! We locked all 4 nodes. 
        // Now we mark this edge so EvaluateSplits knows to execute the split.
        // (You could add a 'uint wantsToSplit' field to HalfEdge3D for this)
        HalfEdges[index].canSplit = 1;
    }
}

[numthreads(8, 1, 1)]
void EvaluateSplits(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int halfEdgeCount = GlobalCounters.Load(4);
    
    if (index >= halfEdgeCount)
        return;
    
    HalfEdge3D edge = HalfEdges[index];
    
    if (edge.wantsToSplit && edge.canSplit)
    {
        // first check if we've already reached max node count before splitting
        uint allocatedNodeID;
        // Atomically add 1, and return the ID we just claimed into 'allocatedNodeID'
        GlobalCounters.InterlockedAdd(0, 1, allocatedNodeID);
        
        
        if (allocatedNodeID < maxNodes)
        {        
            uint edgesNeeded = edge.isBoundary ? 4 : 6;
            uint facesNeeded = edge.isBoundary ? 1 : 2;

            uint startEdgeID, startFaceID;
            GlobalCounters.InterlockedAdd(4, edgesNeeded, startEdgeID);
            GlobalCounters.InterlockedAdd(8, facesNeeded, startFaceID);
        
            SplitTriangle(index, allocatedNodeID, startEdgeID, startFaceID);
        }
        else
        {
            // We failed the race. Revert the node count by subtracting 1 so we don't break the counter.
            uint dummy;
            GlobalCounters.InterlockedAdd(0, -1, dummy);
        }
    }
    
    HalfEdges[index].wantsToSplit = 0; // reset for next frame
    HalfEdges[index].canSplit = 0;
}

// Add this kernel:
[numthreads(8, 1, 1)]
void UnlockNodes(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);
    
    if (index >= (uint) nodeCount)
        return;
        
    // Free the node for the next frame
    NodeLocks[index] = 0;
    
    Nodes[index].debug_int = 0; // reset debug counter each frame
}

// OVER NODES
[numthreads(8, 1, 1)]
void ApplyNaturalForces(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);
    
    if (index >= nodeCount)
        return;
    
    Node3D node = Nodes[index];

    float3 totalForce = float3(0, 0, 0);
    
    int3 currCell = PositionToCellCoord(node.position, separationDistance);
    
    // ==========================================
    // SEPARATION
    // ==========================================
    for (uint i = 0; i < 27; i++)
    {
        int3 offset = Offsets3D[i];
        int3 targetCell = currCell + offset;
        
        uint hash = HashCell(targetCell.x, targetCell.y, targetCell.z);
        uint cellKey = KeyFromHash(hash, hashTableSize);
        
        uint startIndex = StartIndices[cellKey];
        
        if (cellKey == UINT_MAX)
            continue;
        
        for (uint j = startIndex; j < paddedNodeCount; j++)
        {
            if (SpatialLookup[j].cellKey != cellKey) // only check entries in the same cell
                break;
            
            if (SpatialLookup[j].hash != hash) // extra hash check to avoid false positives from different cells that hash to the same key
                continue;
            
            uint otherIndex = SpatialLookup[j].particleIndex;
            
            if (otherIndex >= nodeCount)
                continue;
            
            if (otherIndex == index) // skip self
                continue;
            
            Node3D other = Nodes[otherIndex];
            
            float3 delta = node.position - other.position;
            float distSq = dot(delta, delta);
            
            if (distSq > separationDistance * separationDistance)
                continue;

            float dist = sqrt(distSq);

            if (dist <= 0.0001)
            {
                delta = float3(0.001 * (index % 3 == 0 ? 1 : -1),
                   0.001 * (index % 2 == 0 ? 1 : -1),
                   0.001);
                dist = 0.001;
            }

            float3 repulsionDir = delta / dist;
            float falloffFactor = SpikyKernelPow2(dist, separationDistance);

            
            totalForce += repulsionDir * separationForce * separationDistance * falloffFactor;
        }
    }
    
    
    // ==========================================
    // ATTRACTION & LAPLACIAN
    // ==========================================
    float3 neighborCenter = float3(0, 0, 0);
    int actualNeighborCount = 0;

    uint startEdge = node.halfEdge;
    uint currEdge = startEdge;
    
    // uses a clockwise traversal around the node
    for (int j = 0; j < 32; j++)
    {
        uint neighborNodeIndex = HalfEdges[currEdge].target;
        Node3D neighbor = Nodes[neighborNodeIndex];

        // Attraction
        float3 delta = neighbor.position - node.position;
        float dist = length(delta);
        
        if (dist > 0.00001f)
        {
            float springMagnitude = springStiffness * (dist - restLength);
            totalForce += (delta / dist) * springMagnitude;
        }

        // Accumulate for Laplacian smoothing
        neighborCenter += neighbor.position;
        actualNeighborCount++;
        
        uint twin = HalfEdges[currEdge].twin;
        
        currEdge = HalfEdges[twin].next;
        
        if (currEdge == startEdge)
            break; // Closed mesh, full circle complete!
    }

    // Apply Laplacian Smoothing
    if (actualNeighborCount > 0)
    {   
        neighborCenter /= (float) actualNeighborCount;

        float3 laplacianVector = neighborCenter - node.position;

        totalForce += laplacianVector * laplacianSmoothing;
    }

    // ==========================================
    // APPLY FORCES
    // ==========================================
    totalForce += -node.velocity * nodeDrag;

    // F = m * a, so a = F / m
    float safeMass = max(node.mass, 0.001f);
    node.velocity += (totalForce / safeMass) * deltaTime;
    
    // apply gravity
    node.velocity += float3(0, -gravity * deltaTime, 0);
    
    node.debug_int = HalfEdges[node.halfEdge].twin;
    
    Nodes[index] = node;
}


[numthreads(8,1,1)]
void MoveParticles (uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    
    int nodeCount = GlobalCounters.Load(0);
    
    if (id.x >= nodeCount)
        return;
    
    // apply velocity
    Nodes[index].position += Nodes[index].velocity * deltaTime;
}





