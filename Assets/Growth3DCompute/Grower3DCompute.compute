// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel UpdateEdges

#pragma kernel ResolveFaceCollisions
#pragma kernel ResolveEdgeCollisions
#pragma kernel ApplyAccumulatedVelocities

#pragma kernel CalculateCurvatures
#pragma kernel UpdateAuxinLevels
#pragma kernel ApplyAccumulatedAuxin

#pragma kernel ApplyNaturalForces
#pragma kernel MoveParticles

#include "GrowthHelpers3D.hlsl"
#include "GrowthStructs3D.hlsl"
#include "SpatialHash/SpatialHashHelpers3D.hlsl"
#include "CellTypes.hlsl"

RWStructuredBuffer<Node3D> Nodes : register(u0);
RWStructuredBuffer<HalfEdge3D> HalfEdges : register(u1);
RWStructuredBuffer<Face3D> Faces : register(u2);

// VALUES
float deltaTime;
int frameCount;
int sliceIndex;

uint maxNodes;
uint hashTableSize; // for spatial hashing, nextpoweroftwo(maxNodes)
uint paddedNodeCount; // nextpoweroftwo(nodeCount)

// physics
float separationDistance;
float separationForce;

float gravity;

float baseRestLength;

float springStiffness;
float springDamping;

float lateralDamping;

StructuredBuffer<Entry> SpatialLookup;
StructuredBuffer<uint> StartIndices;

StructuredBuffer<Entry> EdgeSpatialLookup;
StructuredBuffer<uint> EdgeStartIndices;
uint paddedEdgeLookupCount;

StructuredBuffer<Entry> FaceSpatialLookup;
StructuredBuffer<uint> FaceStartIndices;
uint paddedFaceLookupCount;

RWByteAddressBuffer GlobalCounters;

RWStructuredBuffer<int> TotalAuxin;
RWStructuredBuffer<int> AccumulatedAuxinInt;

void AtomicAddAuxin(uint nodeIndex, float auxinToAdd, out int previousValue)
{
    int auxinInt = (int) (auxinToAdd * FLOAT_TO_INT_SCALE);

    InterlockedAdd(
        AccumulatedAuxinInt[nodeIndex],
        auxinInt,
        previousValue
    );
}

// accumulator for velocities to be applied after all collisions are resolved
RWStructuredBuffer<int> AccumulatedVelocityInt;

void AtomicAddVelocity(uint nodeIndex, float3 velocityToAdd)
{
    int3 intVel = (int3) (velocityToAdd * FLOAT_TO_INT_SCALE);
    
    uint base = nodeIndex * 3;
    
    InterlockedAdd(AccumulatedVelocityInt[base], intVel.x);
    InterlockedAdd(AccumulatedVelocityInt[base + 1], intVel.y);
    InterlockedAdd(AccumulatedVelocityInt[base + 2], intVel.z);
}

// UPDATE EDGES
// this kernel updates the edges based on the current state of the nodes and their growth rates. 
// It adjusts the rest length of each edge, based on growth rates.
[numthreads(64, 1, 1)]
void UpdateEdges(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int edgeCount = GlobalCounters.Load(4);
    
    if (index >= edgeCount)
        return;
    
    HalfEdge3D edge = HalfEdges[index];
        
    Node3D node = Nodes[edge.origin];
    Node3D neighbor = Nodes[edge.target];

    NodeType info = node.type;
    
    NodeType neighborInfo = neighbor.type;
    
    // update edges
    edge.age += deltaTime;
    
    // edge growth is based on the average growth rate of the two nodes it connects
    float growthRate = (info.growthRate + neighborInfo.growthRate) / 2.0f;
    edge.currRestLength += growthRate * deltaTime;
    
    if (edge.currRestLength > separationDistance * 1.5f) 
    {
        edge.currRestLength = separationDistance * 1.5f; // clamp rest length to prevent runaway stretching before split can occur
    }
    
    HalfEdges[index] = edge;
}

// RESOLVE COLLISIONS
[numthreads(64, 1, 1)]
void ResolveFaceCollisions(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);
    
    if (index >= nodeCount)
        return;
    
    Node3D node = Nodes[index];
    int3 currCell = PositionToCellCoord(node.position, separationDistance);
    
    float collisionRadius = separationDistance * 0.5f;
    float collisionStiffness = 50.0f;
    
    // Gather 1-Ring Neighbors for Topological Exclusion
    uint neighbors[16];
    int neighborCount = 0;
    uint startEdge = node.halfEdge;
    uint currEdge = startEdge;
    
    if (startEdge != UINT_MAX)
    {
        for (int k = 0; k < 16; k++)
        {
            neighbors[neighborCount++] = HalfEdges[currEdge].target;
            uint twin = HalfEdges[currEdge].twin;
            currEdge = HalfEdges[twin].next;
            if (currEdge == startEdge)
                break;
        }
    }
    
    for (uint i = 0; i < 27; i++)
    {
        int3 offset = Offsets3D[i];
        int3 targetCell = currCell + offset;
        
        uint hash = HashCell(targetCell.x, targetCell.y, targetCell.z);
        uint cellKey = KeyFromHash(hash, hashTableSize);
        uint startIndex = FaceStartIndices[cellKey];
        
        if (cellKey == UINT_MAX || startIndex == UINT_MAX)
            continue;
            
        for (uint j = startIndex; j < paddedFaceLookupCount; j++)
        {
            Entry entry = FaceSpatialLookup[j];
            
            if (entry.cellKey != cellKey)
                break;
            if (entry.hash != hash)
                continue;
            
            Face3D face = Faces[entry.index];
            
            uint edge1 = face.halfEdge;
            uint edge2 = HalfEdges[edge1].next;
            uint edge3 = HalfEdges[edge2].next;
            
            uint nA = HalfEdges[edge1].target;
            uint nB = HalfEdges[edge2].target;
            uint nC = HalfEdges[edge3].target;
            
            // Skip if this node is PART of the face
            if (index == nA || index == nB || index == nC) 
                continue;
                
            // Skip if the face belongs to an immediate neighbor!
            bool isNeighborFace = false;
            for (int k = 0; k < neighborCount; k++)
            {
                if (neighbors[k] == nA || neighbors[k] == nB || neighbors[k] == nC)
                {
                    isNeighborFace = true;
                    break;
                }
            }
            if (isNeighborFace)
                continue;
                
            float3 posA = Nodes[nA].position;
            float3 posB = Nodes[nB].position;
            float3 posC = Nodes[nC].position;
            
            float3 closestPt = ClosestPointOnTriangle(node.position, posA, posB, posC);
            float3 delta = node.position - closestPt;
            float distSq = dot(delta, delta);
            
            if (distSq > 0.000001f && distSq < (collisionRadius * collisionRadius))
            {
                float dist = sqrt(distSq);
                float3 pushDir = delta / dist;
                float penetration = collisionRadius - dist;
                
                node.velocity += pushDir * (penetration * collisionStiffness) * deltaTime;
            }
        }
    }
    
    Nodes[index] = node;
}

[numthreads(64, 1, 1)]
void ResolveEdgeCollisions(uint3 id : SV_DispatchThreadID)
{
    uint edgeIndex = id.x;
    int edgeCount = GlobalCounters.Load(4);

    if (edgeIndex >= edgeCount)
        return;
    
    HalfEdge3D myEdge = HalfEdges[edgeIndex];
    
    // prevent double-counting twins
    if (myEdge.twin != UINT_MAX && edgeIndex > myEdge.twin)
        return;
    
    float3 p1 = Nodes[myEdge.origin].position;
    float3 q1 = Nodes[myEdge.target].position;
    
    float3 edgeCenter = (p1 + q1) * 0.5f;
    int3 currCell = PositionToCellCoord(edgeCenter, separationDistance);
    
    float collisionRadius = separationDistance * 0.1f;
    float collisionStiffness = 50.0f;
    
    for (uint i = 0; i < 27; i++)
    {
        int3 offset = Offsets3D[i];
        int3 targetCell = currCell + offset;
        
        uint hash = HashCell(targetCell.x, targetCell.y, targetCell.z);
        uint cellKey = KeyFromHash(hash, hashTableSize);
        uint startIndex = EdgeStartIndices[cellKey];
        
        if (cellKey == UINT_MAX || startIndex == UINT_MAX)
            continue;
        
        for (uint j = startIndex; j < paddedEdgeLookupCount; j++)
        {
            Entry entry = EdgeSpatialLookup[j];
            
            if (entry.cellKey != cellKey || entry.hash != hash)
                break;
            
            HalfEdge3D otherEdge = HalfEdges[entry.index];
            
            // enforce an order, preventing double-counting edge pairs (eg . edge 5 vs edge 7 and edge 7 vs edge 5)
            if (edgeIndex >= entry.index)
                continue;
            
            // exclude edges that share a vertex (topological neighbors)
            if (myEdge.origin == otherEdge.origin || myEdge.origin == otherEdge.target ||
                myEdge.target == otherEdge.origin || myEdge.target == otherEdge.target)
                continue;
                
            // Do the Edge-Edge Math
            
            // find closest points between the two edges
            float s, t; // parameterized positions along the edges (0.0 to 1.0)
            float3 c1, c2; // actual closest points in 3D space
            
            ClosestPointsOnTwoLineSegments(p1, q1,
                Nodes[otherEdge.origin].position, Nodes[otherEdge.target].position, s, t, c1, c2);
            
            bool isColliding = (length(c1 - c2) < collisionRadius);
            
            // apply forces to all four nodes involved in the edge-edge collision at the same time
            // note: must use interlocked operations
            if (isColliding)
            {
                float3 delta = c1 - c2;
                float dist = length(delta);
    
                // Prevent division by zero
                if (dist > 0.0001f)
                {
                    float3 pushDir = delta / dist;
                    float penetration = collisionRadius - dist;
        
                    // Calculate the total impulse vector to separate the edges
                    float3 impulse = pushDir * (penetration * collisionStiffness * deltaTime);
        
                    // Barycentric distribution based on where the collision happened on the segments
                    // myEdge gets pushed in +pushDir, otherEdge gets pushed in -pushDir
                    float3 forceMyOrigin = impulse * (1.0f - s);
                    float3 forceMyTarget = impulse * s;
                    float3 forceOtherOrigin = -impulse * (1.0f - t);
                    float3 forceOtherTarget = -impulse * t;
        
                    // Atomically add to the accumulator buffer
                    AtomicAddVelocity(myEdge.origin, forceMyOrigin);
                    AtomicAddVelocity(myEdge.target, forceMyTarget);
                    AtomicAddVelocity(otherEdge.origin, forceOtherOrigin);
                    AtomicAddVelocity(otherEdge.target, forceOtherTarget);
                }
            }
        }
    }
}

// run after the collision shader finishes
[numthreads(64, 1, 1)]
void ApplyAccumulatedVelocities(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);

    if (index >= nodeCount)
        return;
    
    int xVel = AccumulatedVelocityInt[index * 3 + 0];
    int yVel = AccumulatedVelocityInt[index * 3 + 1];
    int zVel = AccumulatedVelocityInt[index * 3 + 2];
    
    int3 accIntVel = int3(xVel, yVel, zVel);
    
    // Convert back to float and add to the actual velocity
    float3 finalVelDelta = (float3) accIntVel / FLOAT_TO_INT_SCALE;
    Nodes[index].velocity += finalVelDelta;
    
    // Reset the accumulator for the next frame
    AccumulatedVelocityInt[index * 3 + 0] = 0;
    AccumulatedVelocityInt[index * 3 + 1] = 0;
    AccumulatedVelocityInt[index * 3 + 2] = 0;
}


// calculate local node curvatures
[numthreads(64, 1, 1)]
void CalculateCurvatures(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);
    
    if (index >= nodeCount)
        return;
    
    Node3D node = Nodes[index];
    
    float3 weightedCenter = float3(0, 0, 0);
    float weightSum = 0.0;
    uint startEdge = node.halfEdge;
    uint currEdge = startEdge;
    
    // uses a clockwise traversal around the node
    for (int j = 0; j < 64; j++)
    {
        uint neighborNodeIndex = HalfEdges[currEdge].target;
        Node3D neighbor = Nodes[neighborNodeIndex];
        
        float w = 1.0 / max(length(neighbor.position - node.position), 1e-5);

        weightedCenter += neighbor.position * w;
        weightSum += w;
        
        uint twin = HalfEdges[currEdge].twin;
        
        currEdge = HalfEdges[twin].next;
        
        if (currEdge == startEdge)
            break; // Closed mesh, full circle complete!
    }
    if (weightSum > 0)
    {   
        weightedCenter /= (float) weightSum;
        float3 laplacianVector = weightedCenter - node.position;
        node.curvature = length(laplacianVector);
        
        Nodes[index] = node;
    }
}


[numthreads(64, 1, 1)]
void UpdateAuxinLevels(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);
    
    if (index >= nodeCount)
        return;
    
    Node3D node = Nodes[index];
    NodeType info = node.type;
    int _;

    float myCurrentAuxin = node.currAuxinLevel;
    
    // GENERATION
    float generation = info.auxinGenerationRate * deltaTime;
    if (myCurrentAuxin + generation < 0)
    {
        generation = -myCurrentAuxin; // Prevent dropping below 0
    }
    myCurrentAuxin += generation;
    
    // DIFFUSION (find the max neighbor for canalization)
    HalfEdge3D currEdge = HalfEdges[node.halfEdge];
    float maxAuxinLevel = node.currAuxinLevel; // We look at base levels for canalization
    int maxAuxinNeighborIndex = -1;
    
    float netDiffusionForMe = 0;
    
    float totalStolenForMe = 0; // Track our loot
    
    for (int j = 0; j < 64; j++)
    {
        uint neighborNodeIndex = currEdge.target;
        Node3D neighbor = Nodes[neighborNodeIndex];
        
        // canalization
        if (neighbor.currAuxinLevel > maxAuxinLevel)
        {
            maxAuxinLevel = neighbor.currAuxinLevel;
            maxAuxinNeighborIndex = neighborNodeIndex;
        }
        
        // PASSIVE DIFFUSION
        float gradient = neighbor.currAuxinLevel - node.currAuxinLevel;
        
        float edgeDiffusionRate = (info.auxinDiffusionRate + neighbor.type.auxinDiffusionRate) * 0.5f;
        // Multiply by 0.5 because the neighbor thread will apply the other half to itself
        netDiffusionForMe += gradient * edgeDiffusionRate * 0.5f * deltaTime;
        
        // STEALING
        if (info.auxinStealRate > 0)
        {
            // absorb auxin from neighbors (we ensure this doesnt generate new auxin)
            float requestedSteal = info.auxinStealRate * deltaTime;

            int oldAccumulator;
            AtomicAddAuxin(
                neighborNodeIndex,
                -requestedSteal,
                oldAccumulator
            );

            // Calculate how much auxin the neighbor actually had available
            float previousPending =
                (float) oldAccumulator / FLOAT_TO_INT_SCALE;

            float availableBefore =
                neighbor.currAuxinLevel + previousPending;

            // If we tried to take too much, refund the excess
            float actualSteal = min(requestedSteal, max(availableBefore, 0));

            float refund = requestedSteal - actualSteal;

            if (refund > 0)
            {
                AtomicAddAuxin(
                    neighborNodeIndex,
                    refund,
                    oldAccumulator
                );
            }

            // Give absorbed auxin to this node
            totalStolenForMe += actualSteal;
        }
        
        currEdge = HalfEdges[HalfEdges[currEdge.twin].next];
        if (currEdge.id == node.halfEdge)
            break;
    }
    
    // Clamp diffusion so this node can't give away more than it currently has
    if (myCurrentAuxin + netDiffusionForMe < 0)
    {
        netDiffusionForMe = -myCurrentAuxin;
    }
    myCurrentAuxin += netDiffusionForMe;
    myCurrentAuxin += totalStolenForMe;
    
    // Apply Generation and net Diffusion to THIS node atomically in one clean step
    AtomicAddAuxin(index, generation + netDiffusionForMe + totalStolenForMe, _);
    
    // ACTIVE TRANSPORT
    // Pump to the max neighbor
    if (maxAuxinNeighborIndex != -1 && myCurrentAuxin > 0)
    {
        float auxinTransfer = info.auxinTransportRate * deltaTime;
        
        auxinTransfer = min(auxinTransfer, myCurrentAuxin);
        
        // Take from us, give to the max neighbor
        AtomicAddAuxin(index, -auxinTransfer, _);
        AtomicAddAuxin(maxAuxinNeighborIndex, auxinTransfer, _);
    }
    
    // Notice how Nodes[index] = node; is GONE. 
    // We let the AtomicAddAuxin calls handle memory updates!
}

[numthreads(64, 1, 1)]
void ApplyAccumulatedAuxin(uint3 id : SV_DispatchThreadID)
{
    int index = id.x;
    
    if (index >= GlobalCounters.Load(0))
        return;
    
    Node3D node = Nodes[index];
    float auxinDelta = (float) AccumulatedAuxinInt[index] / FLOAT_TO_INT_SCALE;
    
    float newAuxinLevel = max(node.currAuxinLevel + auxinDelta, 0.0f);
    
    float actualDelta = newAuxinLevel - node.currAuxinLevel;
    
    int actualDeltaInt = (int) (actualDelta * FLOAT_TO_INT_SCALE);
    InterlockedAdd(TotalAuxin[0], actualDeltaInt);
    
    node.currAuxinLevel = newAuxinLevel;
    
    AccumulatedAuxinInt[index] = 0; // reset for next frame
    Nodes[index] = node;
}


// OVER NODES
[numthreads(64, 1, 1)]
void ApplyNaturalForces(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    int nodeCount = GlobalCounters.Load(0);
    
    if (index >= nodeCount)
        return;
    
    Node3D node = Nodes[index];

    float3 totalForce = float3(0, 0, 0);
    float3 vertexNormal = float3(0, 0, 0);
    
    int3 currCell = PositionToCellCoord(node.position, separationDistance);
    
    NodeType info = node.type;
    
    // ==========================================
    // SEPARATION
    // ==========================================
    for (uint i = 0; i < 27; i++)
    {
        int3 offset = Offsets3D[i];
        int3 targetCell = currCell + offset;
        
        uint hash = HashCell(targetCell.x, targetCell.y, targetCell.z);
        uint cellKey = KeyFromHash(hash, hashTableSize);
        
        uint startIndex = StartIndices[cellKey];
        
        if (cellKey == UINT_MAX)
            continue;
        
        for (uint j = startIndex; j < paddedNodeCount; j++)
        {
            if (SpatialLookup[j].cellKey != cellKey) // only check entries in the same cell
                break;
            
            if (SpatialLookup[j].hash != hash) // extra hash check to avoid false positives from different cells that hash to the same key
                continue;
            
            uint otherIndex = SpatialLookup[j].index;
            
            if (otherIndex >= nodeCount)
                continue;
            
            if (otherIndex == index) // skip self
                continue;
            
            Node3D other = Nodes[otherIndex];
            
            float3 delta = node.position - other.position;
            float distSq = dot(delta, delta);
            
            if (distSq > separationDistance * separationDistance)
                continue;

            float dist = sqrt(distSq);

            if (dist <= 0.0001)
            {
                // Generate a pseudo-random direction based on the position itself
                float rx = frac(sin(dot(node.position.xy, float2(12.9898, 78.233))) * 43758.5453);
                float ry = frac(sin(dot(node.position.yz, float2(12.9898, 78.233))) * 43758.5453);
                float rz = frac(sin(dot(node.position.zx, float2(12.9898, 78.233))) * 43758.5453);
    
                // Convert 0..1 range to -0.5..0.5, normalize, and scale
                delta = normalize(float3(rx, ry, rz) - 0.5f) * 0.001f;
                dist = 0.001;
            }

            float3 repulsionDir = delta / dist;
            float falloffFactor = SpikyKernelPow2(dist, separationDistance);

            
            totalForce += repulsionDir * separationForce * separationDistance * falloffFactor;
        }
    }
    
    // ==========================================
    // ATTRACTION & LAPLACIAN
    // ==========================================
    float3 neighborCenter = float3(0, 0, 0);
    int actualNeighborCount = 0;

    uint startEdge = node.halfEdge;
    uint currEdge = startEdge;
    
    // uses a clockwise traversal around the node
    for (int j = 0; j < 64; j++)
    {
        uint neighborNodeIndex = HalfEdges[currEdge].target;
        Node3D neighbor = Nodes[neighborNodeIndex];
        
        NodeType neighborInfo;
        GetCellInfo(neighbor.baseType, neighborInfo);

        // attraction (spring forces)
        float3 delta = neighbor.position - node.position; // Points toward neighbor
        float dist = length(delta);
        
        if (dist > 0.00001f)
        {
            float3 dir = delta / dist;

            // Spring force
            float springMagnitude = springStiffness * (dist - HalfEdges[currEdge].currRestLength);

            // Relative velocity
            float3 relativeVelocity = neighbor.velocity - node.velocity;

            // Split into parallel/perpendicular components
            float relativeSpeed = dot(relativeVelocity, dir);
            float3 parallelVelocity = relativeSpeed * dir;
            float3 perpendicularVelocity = relativeVelocity - parallelVelocity;

            // Effective mass
            float m1 = max(info.mass, 1e-5);
            float m2 = max(neighborInfo.mass, 1e-5);
            float effectiveMass = (m1 * m2) / (m1 + m2);

            // Critical damping coefficient
            float criticalDamping = 2.0f * sqrt(springStiffness * effectiveMass);

            // Spring damping (0 = none, 1 = critical)
            float springDampingCoefficient = springDamping * criticalDamping;

            // Lateral damping (same scale)
            float lateralDampingCoefficient = lateralDamping * criticalDamping;

            // Forces
            float3 springForce = dir * springMagnitude;
            float3 springDampingForce = dir * (springDampingCoefficient * relativeSpeed);
            float3 lateralDampingForce = lateralDampingCoefficient * perpendicularVelocity;

            totalForce += springForce
                + springDampingForce
                + lateralDampingForce;
        }
        
        // Accumulate for Laplacian smoothing
        neighborCenter += neighbor.position;
        actualNeighborCount++;
        
        // ------------------------------------------------------
        // Calculate Face Normal for Turgor Pressure
        // To get the face normal, we need the NEXT node in this triangle
        uint nextEdgeIndex = HalfEdges[currEdge].next;
        uint nextNeighborIndex = HalfEdges[nextEdgeIndex].target;
        Node3D nextNeighbor = Nodes[nextNeighborIndex];

        float3 v1 = neighbor.position - node.position;
        float3 v2 = nextNeighbor.position - node.position;
        
        // The cross product gives a normal vector perpendicular to the face.
        // Its magnitude is proportional to the face area, providing perfect area-weighted pressure.
        float3 faceNormal = cross(v1, v2);
        vertexNormal += faceNormal;
        // ------------------------------------------------------
        
        uint twin = HalfEdges[currEdge].twin;
        
        currEdge = HalfEdges[twin].next;
        
        if (currEdge == startEdge)
            break; // Closed mesh, full circle complete!
    }

    // Apply Laplacian Smoothing
    if (actualNeighborCount > 0)
    {   
        neighborCenter /= (float) actualNeighborCount;

        float3 laplacianVector = neighborCenter - node.position;

        node.velocity += laplacianVector * info.laplacianSmoothing * deltaTime;
    }

    // Apply Turgor Pressure Force
    if (length(vertexNormal) > 0.0001f)
    {
        // Normalize the accumulated vectors to get the final smooth vertex normal
        vertexNormal = normalize(vertexNormal);
        
        // Push the node outward along its normal
        totalForce += vertexNormal * info.turgorPressure;
    }
    
    // ==========================================
    // APPLY FORCES
    // ==========================================
    
    // F = m * a, so a = F / m
    float safeMass = max(info.mass, 0.001f);
    node.velocity += (totalForce / safeMass) * deltaTime;
    
    // apply gravity
    node.velocity += float3(0, -gravity * deltaTime, 0);

    // Apply drag as exponential decay (framerate independent and unconditionally stable)
    node.velocity *= exp(-info.drag * deltaTime);
    
    node.debug_int = HalfEdges[node.halfEdge].twin;
    
    Nodes[index] = node;
}


[numthreads(64,1,1)]
void MoveParticles (uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    
    int nodeCount = GlobalCounters.Load(0);
    
    if (id.x >= nodeCount)
        return;
    
    NodeType info = Nodes[index].type;
    
    // age nodes
    Nodes[index].age += deltaTime;
    
    // switch types if the node has reached its switch time
    if (Nodes[index].currAuxinLevel > info.auxinThreshold || (info.switchTime > 0 && Nodes[index].age > info.switchTime))
    {
        if (Nodes[index].baseType != info.targetType)
        {
            Nodes[index].age = 0.0f; // reset age when switching types
        }
        
        Nodes[index].baseType = info.targetType;
        
        GetCellInfo(Nodes[index].baseType, Nodes[index].type);
    }
    
    // apply velocity
    Nodes[index].position += Nodes[index].velocity * deltaTime;
}





