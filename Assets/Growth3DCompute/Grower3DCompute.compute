// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel EvaluateSplits

#pragma kernel ApplyNaturalForces
#pragma kernel MoveParticles

#include "GrowthHelpers3D.hlsl"

RWStructuredBuffer<Node3D> Nodes;

// VALUES
float deltaTime;

uint maxNodes;
uint nodeCount;
uint paddedNodeCount;

float separationDistance;
float separationForce;

float attractionForce;
float laplacianSmoothing;

float nodeDrag;

float splitDistanceThreshold;

//StructuredBuffer<uint> NeighborIndices;
StructuredBuffer<Entry> SpatialLookup;
StructuredBuffer<uint> StartIndices;

RWByteAddressBuffer NodeCounter; 

[numthreads(8, 1, 1)]
void EvaluateSplits(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= nodeCount)
        return;

    Node3D node = Nodes[index];
    
    // Use a flag instead of "return" to handle buffer capacity
    bool capacityReached = false;

    for (int i = 0; i < 8; i++)
    {
        // Replaced 'break' with a clean if-condition
        if (!capacityReached && i < node.neighborCount)
        {
            int neighborIndex = node.neighbors[i];

            // Replaced 'continue' with an if-condition
            if (index < (uint) neighborIndex)
            {
                Node3D neighbor = Nodes[neighborIndex];
                float dist = distance(node.position, neighbor.position);

                if (dist > splitDistanceThreshold)
                {
                    if (nodeCount >= maxNodes)
                    {
                        capacityReached = true;
                    }
                    
                    uint newNodeIndex;
                    NodeCounter.InterlockedAdd(0, 1, newNodeIndex);

                    // Replaced 'return' with flag toggle
                    if (newNodeIndex >= maxNodes)
                    {
                        capacityReached = true;
                    }
                    else
                    {
                        // 2. Create the new node at the midpoint
                        Node3D newNode;
                        newNode.position = (node.position + neighbor.position) * 0.5f;
                        newNode.velocity = float3(0, 0, 0);
                        newNode.curvature = 0.0f;
                        newNode.mass = 1.0f;
                        newNode.neighborCount = 2; // Connects to the two parents
                        newNode.neighbors[0] = index;
                        newNode.neighbors[1] = neighborIndex;
                        newNode.neighbors[2] = 0;
                        newNode.neighbors[3] = 0;
                        newNode.neighbors[4] = 0;
                        newNode.neighbors[5] = 0;
                        newNode.neighbors[6] = 0;
                        newNode.neighbors[7] = 0;

                        // Save new node
                        Nodes[newNodeIndex] = newNode;

                        // Update Parent A (Current Node)
                        node.neighbors[i] = newNodeIndex;
                        Nodes[index] = node;

                        // Update Parent B (Neighbor Node)
                        bool replaced = false; // Flag to replace 'break'
                        
                        for (int j = 0; j < 8; j++)
                        {
                            if (!replaced && j < neighbor.neighborCount)
                            {
                                if (neighbor.neighbors[j] == (int) index)
                                {
                                    neighbor.neighbors[j] = newNodeIndex;
                                    Nodes[neighborIndex] = neighbor; // Write back to buffer
                                    replaced = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 
[numthreads(8, 1, 1)]
void ApplyNaturalForces(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    
    if (id.x >= nodeCount)
        return;
    
    Node3D node = Nodes[index];

    float3 totalForce = float3(0, 0, 0);
    
    int3 currCell = PositionToCellCoord(node.position, separationDistance);
    
    // SEPARATION
    for (uint i = 0; i < 27; i++)
    {
        int3 offset = Offsets3D[i];
        int3 neighborCell = currCell + int3(offset.x, offset.y, offset.z);
        
        uint hash = HashCell(neighborCell.x, neighborCell.y, neighborCell.z);
        uint cellKey = KeyFromHash(hash, maxNodes);
        
        uint startIndex = StartIndices[cellKey]; // get start index for this cell from precomputed start indices
        
        if (startIndex == UINT_MAX)
            continue;
        
        for (uint j = startIndex; j < maxNodes; j++)
        {
            // If the cell key changes, we've exited this cell's block of particles. Stop checking.
            if (SpatialLookup[j].cellKey != cellKey)
                break;
            
            uint otherIndex = SpatialLookup[j].particleIndex;
            
            // If the other index is the same as the current node, skip to avoid self-interaction
            if (otherIndex == index)
                continue;
            
            Node3D other = Nodes[otherIndex];
            
            float3 delta = node.position - other.position;
            float distSq = dot(delta, delta);
            if (distSq > separationDistance * separationDistance)
                continue;

            float dist = sqrt(distSq);

            if (dist <= 0.0001)
                continue;

            float3 repulsionDir = delta / dist;
            float falloffFactor =
            SpikyKernelPow2(
                dist,
                separationDistance
            );

            totalForce +=
                repulsionDir *
                separationForce *
                separationDistance *
                falloffFactor;
        }
        
    }
    
    // ATTRACTION
    if (node.neighborCount > 0)
    {
        float3 neighborCenter = float3(0, 0, 0);
        
        [unroll(8)]
        for (int j = 0; j < 8; j++)
        {
            if (j >= node.neighborCount)
            {
                break;
            }
            
            uint neighborNodeIndex = node.neighbors[j];
        
            Node3D neighbor = Nodes[neighborNodeIndex];

            float3 attractionDir = normalize(neighbor.position - node.position);
            totalForce += attractionDir * attractionForce;

            // Add to centroid for Laplacian smoothing
            neighborCenter += neighbor.position;
        }
        
        neighborCenter /= (float) node.neighborCount;
        float3 laplacianVector = neighborCenter - node.position;
        totalForce += laplacianVector * laplacianSmoothing;
    }

    totalForce += -node.velocity * nodeDrag;

    // F = m * a, so a = F / m
    node.velocity += totalForce / node.mass * deltaTime;
    
    Nodes[index] = node;
}

[numthreads(8,1,1)]
void MoveParticles (uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    
    if (id.x >= nodeCount)
        return;
    
    // apply velocity
    Nodes[index].position += Nodes[index].velocity * deltaTime;
}

